<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ai_agent_log_view_list" model="ir.ui.view">
        <field name="name">ai.agent.log.list</field>
        <field name="model">ai.agent.log</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" decoration-danger="not success">
                <field name="create_date" string="Time"/>
                <field name="agent_id"/>
                <field name="action"/>
                <field name="status"/>
                <field name="summary"/>
                <field name="error" optional="show"/>
                <field name="remote_addr" optional="hide"/>
                <field name="success" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="ai_agent_log_view_form" model="ir.ui.view">
        <field name="name">ai.agent.log.form</field>
        <field name="model">ai.agent.log</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date" string="Time"/>
                            <field name="agent_id"/>
                            <field name="action"/>
                            <field name="status"/>
                            <field name="success"/>
                        </group>
                        <group>
                            <field name="summary"/>
                            <field name="error"/>
                            <field name="remote_addr"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ai_agent_log_view_search" model="ir.ui.view">
        <field name="name">ai.agent.log.search</field>
        <field name="model">ai.agent.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="agent_id"/>
                <field name="action"/>
                <filter name="failed" string="Rejected" domain="[('success', '=', False)]"/>
                <filter name="today" string="Last 24 hours"
                        domain="[('create_date', '>=', (context_today() - relativedelta(days=1)).strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_agent" string="Agent" context="{'group_by': 'agent_id'}"/>
                    <filter name="group_action" string="Action" context="{'group_by': 'action'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ai_agent_log_action" model="ir.actions.act_window">
        <field name="name">Agent Calls</field>
        <field name="res_model">ai.agent.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
