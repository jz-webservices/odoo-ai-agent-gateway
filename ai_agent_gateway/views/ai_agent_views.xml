<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ai_agent_view_list" model="ir.ui.view">
        <field name="name">ai.agent.list</field>
        <field name="model">ai.agent</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="token_hint" string="Token"/>
                <field name="can_read_posts" optional="show"/>
                <field name="can_write_drafts" optional="show"/>
                <field name="can_use_attachments" optional="show"/>
                <field name="can_send_mail" optional="show"/>
                <field name="last_call"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="ai_agent_view_form" model="ir.ui.view">
        <field name="name">ai.agent.form</field>
        <field name="model">ai.agent</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_token" type="object" class="btn-primary"
                            string="Generate token" invisible="has_token"/>
                    <button name="action_generate_token" type="object" string="Replace token"
                            invisible="not has_token"
                            confirm="The current token stops working immediately. Continue?"/>
                    <button name="action_revoke_token" type="object" string="Revoke token"
                            invisible="not has_token"
                            confirm="The agent will no longer be able to call the gateway. Continue?"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_posts" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="post_count" widget="statinfo" string="Drafts"/>
                        </button>
                        <button name="action_view_logs" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="log_count" widget="statinfo" string="Calls"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Weekly blog writer"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="token_hint" string="Current token" placeholder="no token yet"/>
                            <field name="has_token" invisible="1"/>
                            <field name="last_call"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="description" placeholder="What does this agent do? Where does its prompt live?"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Permissions" name="permissions">
                            <group>
                                <group string="Allowed actions">
                                    <field name="can_read_posts"/>
                                    <field name="can_write_drafts"/>
                                    <field name="can_use_attachments"/>
                                    <field name="can_send_mail"/>
                                </group>
                                <group string="Blogs">
                                    <field name="read_blog_ids" widget="many2many_tags"/>
                                    <field name="write_blog_ids" widget="many2many_tags"/>
                                    <field name="author_id"/>
                                    <field name="edit_agent_ids" widget="many2many_tags"
                                           domain="[('id', '!=', id)]"/>
                                </group>
                            </group>
                            <group string="Shared files">
                                <field name="attachment_ids" nolabel="1" colspan="2">
                                    <list>
                                        <field name="name"/>
                                        <field name="mimetype"/>
                                        <field name="file_size"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page string="Mail and limits" name="limits">
                            <group>
                                <group string="Review mails">
                                    <field name="mail_from" placeholder="Blog Agent &lt;noreply@example.com&gt;"/>
                                    <field name="mail_to" placeholder="editor@example.com"/>
                                    <field name="mail_limit_per_day"/>
                                </group>
                                <group string="Rate limit">
                                    <field name="request_limit_per_hour"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ai_agent_view_search" model="ir.ui.view">
        <field name="name">ai.agent.search</field>
        <field name="model">ai.agent</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="ai_agent_action" model="ir.actions.act_window">
        <field name="name">AI Agents</field>
        <field name="res_model">ai.agent</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first AI agent</p>
            <p>Each agent gets its own token and only the rights you tick here -
               instead of a full Odoo API key.</p>
        </field>
    </record>

    <record id="ai_agent_token_wizard_view_form" model="ir.ui.view">
        <field name="name">ai.agent.token.wizard.form</field>
        <field name="model">ai.agent.token.wizard</field>
        <field name="arch" type="xml">
            <form>
                <div class="alert alert-warning" role="alert">
                    Copy this token now and store it in your agent's secret store.
                    It is shown only once - Odoo keeps only its hash.
                </div>
                <group>
                    <field name="agent_id" readonly="1"/>
                    <field name="token" widget="CopyClipboardChar"/>
                </group>
                <footer>
                    <button name="action_close" type="object" string="I have stored the token" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
